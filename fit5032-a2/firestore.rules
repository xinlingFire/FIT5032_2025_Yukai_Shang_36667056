rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    match /profiles/{userId} { allow read: if signedIn(); allow create, update: if signedIn() && request.auth.uid == userId; }
    match /resources/{resourceId} { allow read: if true; allow write: if isAdmin(); }
    match /bookings/{bookingId} { allow create: if signedIn() && request.resource.data.userId == request.auth.uid; allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin()); }
  }
}
